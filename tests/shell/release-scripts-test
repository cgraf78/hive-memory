#!/usr/bin/env bash
# shellcheck disable=SC1091
# Hive Memory-specific release coverage.
#
# The release scripts themselves are vendored from cgraf78/actions and covered
# by that repo's test/release-scripts-test: identity resolution, packaging,
# smoke validation, and local tag cutting all live there. Re-asserting them here
# would recreate the triplicated coverage this consolidation removed.
#
# What stays is what only this repo can know: that release.conf declares the
# payload Hive Memory actually ships, that the smoke hook works, and that the
# workflows wire the shared release contract the way this project needs.

set -uo pipefail

HIVE_MEMORY_DIR="$(cd "$(dirname "$0")/../.." && pwd)"

# shellcheck source=helpers.sh
. "$(dirname "$0")/helpers.sh"

echo "=== Release scripts ==="

# shellcheck source=../../scripts/release.conf
. "$HIVE_MEMORY_DIR/scripts/release.conf"

_assert_eq "release config: uses the Hive Memory env namespace" \
  "HIVE_MEMORY" "$RELEASE_ENV_PREFIX"
# The repo is hive-memory but the CLI and its archives are named hm. Getting
# this backwards would rename every published asset.
_assert_eq "release config: publishes hm-prefixed archives" "hm" "$RELEASE_ASSET_NAME"
_assert_eq "release config: builds the hm binary" "hm" "$RELEASE_BINARY"
_assert_eq "release config: keys install metadata off the repo slug" \
  "hive-memory" "$RELEASE_SLUG"

# A declared entry that no longer exists fails the release on a runner rather
# than here, which is a slow way to discover a rename.
for _entry in "${RELEASE_PAYLOAD_FILES[@]}"; do
  if [[ -f "$HIVE_MEMORY_DIR/$_entry" ]]; then
    _pass "release config: declared payload exists: $_entry"
  else
    _fail "release config: declared payload exists: $_entry"
  fi
done

# The man page is the one payload entry that is easy to move without noticing,
# because nothing else in the build references its path.
_declared() {
  local needle=$1 entry
  for entry in "${RELEASE_PAYLOAD_FILES[@]}"; do
    [[ "$entry" == "$needle" ]] && return 0
  done
  return 1
}

while IFS= read -r _tracked; do
  if _declared "$_tracked"; then
    _pass "release config: ships tracked man page: $_tracked"
  else
    _fail "release config: ships tracked man page: $_tracked"
  fi
done < <(git -C "$HIVE_MEMORY_DIR" ls-files -- 'man/man1/*.1')

# --- Smoke hook -------------------------------------------------------------

# shellcheck source=../../scripts/release-smoke-hook.sh
. "$HIVE_MEMORY_DIR/scripts/release-smoke-hook.sh"

if declare -F release_smoke_check >/dev/null; then
  _pass "smoke hook: defines release_smoke_check"
else
  _fail "smoke hook: defines release_smoke_check"
fi

# The hook builds a throwaway store and config. A hook that leaves those behind
# would slowly fill a release runner's temp space across matrix rows. Point the
# hook at a private TMPDIR so the count is exact rather than racing whatever
# else is using the system temp directory.
_hook_fake=$(mktemp -d)
_hook_tmp=$(mktemp -d)
cat >"$_hook_fake/hm" <<'HM'
#!/usr/bin/env bash
exit 0
HM
chmod +x "$_hook_fake/hm"
(TMPDIR="$_hook_tmp" release_smoke_check "$_hook_fake" linux-x86_64-musl) >/dev/null 2>&1
# Emptiness rather than a count: BSD `wc -l` pads its output with leading
# whitespace, so a numeric string comparison fails on macOS runners.
_hook_left=$(ls -A "$_hook_tmp")
rm -rf "$_hook_fake" "$_hook_tmp"
_assert_eq "smoke hook: cleans up its store and config fixtures" "" "$_hook_left"

# A failing binary must fail the smoke test rather than being swallowed.
_hook_fail=$(mktemp -d)
cat >"$_hook_fail/hm" <<'HM'
#!/usr/bin/env bash
exit 3
HM
chmod +x "$_hook_fail/hm"
rc=0
release_smoke_check "$_hook_fail" linux-x86_64-musl >/dev/null 2>&1 || rc=$?
rm -rf "$_hook_fail"
if [[ "$rc" -ne 0 ]]; then
  _pass "smoke hook: propagates a failing binary"
else
  _fail "smoke hook: propagates a failing binary"
fi

# --- Workflow contract ------------------------------------------------------

_release_workflow=$(cat "$HIVE_MEMORY_DIR/.github/workflows/release.yml")
_assert_contains "release workflow: uses exact reusable tag command" \
  'tag-command: scripts/release-tag.sh' "$_release_workflow"

# The broader consumer verifier keeps the action pin and all generated files in
# one contract; checking its exact action name prevents a silent fallback to
# the older release-script-only check.
_ci_workflow=$(cat "$HIVE_MEMORY_DIR/.github/workflows/ci.yml")
_assert_contains "ci workflow: verifies the complete shared CI snapshot" \
  "cgraf78/actions/.github/actions/verify-consumer-sync@" "$_ci_workflow"

_test_summary
